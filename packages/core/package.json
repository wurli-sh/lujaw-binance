{
  "name": "@lujaw-binance/core",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "keywords": ["binance", "spot", "mcp", "policy", "venus", "defi", "risk"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wurli-sh/lujaw-binance.git",
    "directory": "packages/core"
  },
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@altananetwork/sdk": "0.7.1",
    "viem": "2.55.17",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "typescript": "5.8.2",
    "vitest": "3.0.8"
  }
}
