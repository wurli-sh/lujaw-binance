# LUJAW — copy to .env and fill in.
# Never commit .env or any private key / OAuth token.

# --- Binance Spot (primary demo) ------------------------------------------
# LUJAW does not store Binance OAuth tokens. Connect official Binance MCP in
# Cursor. Optional disposable demo ceilings (defaults match demo preset):
# LUJAW_BINANCE_MAX_ORDER_NOTIONAL=25
# LUJAW_BINANCE_MAX_DAILY_GROSS_NOTIONAL=50
# LUJAW_BINANCE_MIN_QUOTE_RESERVE=5
# LUJAW_STATE_DIR=.lujaw

# --- Venus secondary / BSC testnet (chain 97) -----------------------------
# Optional for read-only market inspection; the public BSC testnet RPC is used
# when omitted. Set an explicit RPC for repeatable demos and all write flows.
BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com
# Optional fallback if the primary RPC is rate-limited:
# BSC_TESTNET_FALLBACK_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# --- Roles (Venus only) ---------------------------------------------------
# OWNER holds the Venus position, creates the ERC-20 allowance, grants and
# revokes the Altana session, and pays relay fees. Needs tBNB + mock USDT.
OWNER_PRIVATE_KEY=

# SESSION signs only the scoped execute call. Generate with `cast wallet new`.
# Needs no funding — Altana sponsors from the owner wallet.
SESSION_PRIVATE_KEY=

# --- Gate 0 knobs (optional, Venus) ---------------------------------------
# Defaults to the owner address derived from OWNER_PRIVATE_KEY.
# GATE0_ACCOUNT=

# Raw top-up amount in underlying units (testnet mock USDT is 6 decimals).
# Default: 1000000 (1 USDT).
# GATE0_TOP_UP_RAW=1000000

# Token spend cap for the session (raw). Default: 5000000 (5 USDT).
# GATE0_SPEND_CAP_RAW=5000000

# Native relay-fee cap in wei. Default: 0.01 tBNB.
# GATE0_NATIVE_CAP_WEI=10000000000000000

# Force the USDC failover market instead of USDT.
# GATE0_MARKET=USDT
