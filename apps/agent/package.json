{
  "name": "@lujaw-binance/agent",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "LUJAW CLI, MCP server, and runtime over @lujaw-binance/core",
  "engines": {
    "node": ">=20.12"
  },
  "keywords": ["mcp", "binance-agent-os", "venus", "defi", "risk"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wurli-sh/lujaw-binance.git",
    "directory": "apps/agent"
  },
  "files": ["dist"],
  "bin": {
    "lujaw": "./dist/cli.js",
    "lujaw-mcp": "./dist/mcp.js"
  },
  "main": "./dist/runtime.js",
  "types": "./dist/runtime.d.ts",
  "exports": {
    ".": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/deployments && cp ../../deployments/bsc-testnet.json dist/deployments/bsc-testnet.json",
    "lujaw": "tsx src/cli.ts",
    "mcp": "tsx src/mcp.ts",
    "typecheck": "pnpm --filter @lujaw-binance/core build && tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @lujaw-binance/core build",
    "test": "vitest run",
    "prepack": "pnpm build",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@lujaw-binance/core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.12.1",
    "viem": "2.55.17",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "vitest": "3.0.8"
  }
}
