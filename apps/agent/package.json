{
  "name": "@lujaw/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LUJAW CLI, MCP server, and runtime over @lujaw/core",
  "bin": {
    "lujaw": "./bin/lujaw.mjs"
  },
  "exports": {
    ".": "./src/runtime.ts"
  },
  "scripts": {
    "lujaw": "tsx src/cli.ts",
    "mcp": "tsx src/mcp.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@lujaw/core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.12.1",
    "viem": "2.55.17",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "vitest": "3.0.8"
  }
}
